# --- Pflicht ---
DATABASE_URL="postgresql://user:pass@host:5432/railway"

# LLM-Anbindung: jeder OpenAI-kompatible Anbieter (OpenRouter, Groq, Ollama, Anthropic, …)
LLM_API_KEY="sk-or-..."

# Passwort für das Web-UI (Single-User)
APP_PASSWORD="bitte-aendern"

# Shared Secret, das der Browser-Collector im Header x-collector-key mitschickt
COLLECTOR_KEY="langer-zufallsstring-bitte-aendern"

# Öffentliche URL der App (wird auf der Setup-Seite angezeigt)
NEXT_PUBLIC_APP_URL="https://deine-app.up.railway.app"

# --- Optional: nur Startwerte/Fallbacks ---
# Anbieter und Modelle werden im UI unter /settings gepflegt (in der DB gespeichert).
# Diese Variablen greifen nur, solange dort nichts gesetzt ist.
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_MODEL="meta-llama/llama-3.3-70b-instruct"
# LLM_MODEL_TRIAGE="meta-llama/llama-3.3-70b-instruct:free"
#
# Beispiele für andere Anbieter:
#   Groq:      LLM_BASE_URL="https://api.groq.com/openai/v1"  LLM_MODEL="llama-3.3-70b-versatile"
#   Ollama:    LLM_BASE_URL="http://localhost:11434/v1"       LLM_MODEL="qwen2.5:14b"  LLM_API_KEY="ollama"
#   Anthropic: LLM_BASE_URL="https://api.anthropic.com/v1"    LLM_MODEL="claude-sonnet-4-5"
